# Never commit .env. setup_local generates fresh secrets.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_32_PLUS_CHARACTER_SECRET
DATABASE_URL=sqlite:///./runtime/supportflow.db
QDRANT_PATH=./runtime/qdrant
QDRANT_URL=
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
MODEL_MODE=extractive
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
INPUT_COST_PER_MILLION=0
OUTPUT_COST_PER_MILLION=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
ENABLE_EVALS=false
# Empty means unknown, never a fabricated current status.
STATUS_URL=
DEEPEVAL_TELEMETRY_OPT_OUT=YES
OTEL_SDK_DISABLED=false
# Optional semantic embeddings via an OpenAI-compatible API; explicit opt-in.
EMBEDDING_MODE=hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_COST_PER_MILLION=0
